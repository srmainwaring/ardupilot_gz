<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="iris_arm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import iris_arm urdf file -->
    <xacro:include filename="$(find ardupilot_gz_description)/models/learm/model.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="iris_arm.ros2_control.xacro" />


    <xacro:iris_arm_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
